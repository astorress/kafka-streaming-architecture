                <mxCell id="produce-alert" edge="1" parent="arch-flow" source="dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#66A34A;endArrow=block;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" target="alerts" value="">
                    <mxGeometry relative="1" as="geometry">
